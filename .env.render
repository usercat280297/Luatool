# ===== Required =====
BOT_TOKEN=PUT_YOUR_DISCORD_BOT_TOKEN_HERE
NODE_ENV=production
PUBLIC_BASE_URL=https://YOUR_NEW_RENDER_SERVICE.onrender.com

# ===== Discord login/retry =====
DISCORD_FORCE_IPV4=true
DISCORD_REST_PRECHECK_ENABLED=false
DISCORD_LOGIN_TIMEOUT_MS=120000
DISCORD_LOGIN_RETRY_MAX_DELAY_MS=300000
DISCORD_NOISY_LOG_SUPPRESS=true
DISCORD_NOISY_LOG_COOLDOWN_MS=60000

# ===== Slash command scope =====
REGISTER_GLOBAL_SLASH_COMMAND=false
REGISTER_GUILD_SLASH_COMMAND=true

# ===== Download / upload settings =====
GITHUB_CONTENTS_SAFE_LIMIT_MB=70
GITHUB_UPLOAD_TIMEOUT_MS=120000
GITHUB_UPLOAD_MAX_RETRIES=6
GITHUB_UPLOAD_RETRY_DELAY_MS=4000
DISABLE_DIRECT_DOWNLOAD_FALLBACK=false
DIRECT_DOWNLOAD_TTL_MINUTES=360

# ===== Quota =====
ENABLE_DAILY_DOWNLOAD_LIMIT=false
# MAX_DAILY_DOWNLOADS_PER_USER=25
# DAILY_LIMIT_TIMEZONE=Asia/Ho_Chi_Minh
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# UPSTASH_DAILY_QUOTA_PREFIX=luatool:quota

# ===== Optional GitHub upload =====
GITHUB_TOKEN=
GITHUB_REPO_OWNER=usercat280297
GITHUB_REPO_NAME=Luatool

# ===== Optional upstream fetch =====
MORRENUS_API_BASE_URL=https://manifest.morrenus.xyz
MORRENUS_API_KEY=
MORRENUS_API_KEYS=
MORRENUS_REQUEST_TIMEOUT_MS=120000
GET_PROCESSING_DELAY_MS=9000

# ===== Morrenus Playwright auto-regen (Render/persistent disk) =====
# BOT_DATA_DIR=/var/data
# MORRENUS_SESSION_DIR=/var/data/.playwright-session
# MORRENUS_KEY_FILE=/var/data/.morrenus_active_key
# PLAYWRIGHT_BROWSERS_PATH=/var/data/playwright-browsers
# PLAYWRIGHT_INSTALL=1
# MORRENUS_SESSION_STATE_B64=

# ===== Logging =====
ENABLE_DETAILED_LOGGING=false
DEBUG_MESSAGE_LOGGING=false
LOG_TO_FILE=true
LOG_MAX_SIZE_MB=10
LOG_MAX_FILES=7

# ===== Checksum =====
CHECKSUM_ENABLED=true
CHECKSUM_MAX_SIZE_MB=200
CHECKSUM_ENGINE=js
CHECKSUM_ENGINE_TIMEOUT_MS=45000

# ===== Engines =====
STEAM_INFO_ENGINE=js
STEAM_INFO_ENGINE_TIMEOUT_MS=10000
STEAMDB_ENGINE=js
STEAMDB_ENGINE_TIMEOUT_MS=15000
